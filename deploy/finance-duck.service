[Unit]
Description=FinanceDuck Node.js application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=financeduck
Group=financeduck
WorkingDirectory=/opt/finance-duck
EnvironmentFile=/opt/finance-duck/.env
ExecStart=/usr/bin/node /opt/finance-duck/dist-server/index.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/finance-duck/app.log
StandardError=append:/var/log/finance-duck/error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/finance-duck /var/log/finance-duck

[Install]
WantedBy=multi-user.target
