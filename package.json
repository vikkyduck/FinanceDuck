{
  "name": "finance-duck",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/vite.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/vite.ts server/migrate.ts server/migrateDocuments.ts server/worker.ts server/backupCli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist-server --entry-names=[name] && mv dist-server/vite.js dist-server/index.js",
    "build": "npm run build:client && npm run build:server",
    "worker": "NODE_ENV=production node dist-server/worker.js",
    "dev:worker": "tsx server/worker.ts",
    "start": "NODE_ENV=production node dist-server/index.js",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist-server/migrate.js",
    "typecheck:client": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "db:migrate:documents": "node dist-server/migrateDocuments.js",
    "test:load": "node --max-old-space-size=256 --import tsx scripts/benchmark.ts"
  },
