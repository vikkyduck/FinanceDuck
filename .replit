modules = ["nodejs-20", "web", "bun", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:1.0.0"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "bun install --frozen-lockfile && bun run build"]
publicDir = "dist"
run = ["bash", "-c", "NODE_ENV=production bun run server/vite.ts"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run server/vite.ts"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3002

[[ports]]
localPort = 35563
externalPort = 3000

[[ports]]
localPort = 36051
externalPort = 5173

[[ports]]
localPort = 36237
externalPort = 6000

[[ports]]
localPort = 37297
externalPort = 3003

[[ports]]
localPort = 38727
externalPort = 3001

[[ports]]
localPort = 46453
externalPort = 4200

[[ports]]
localPort = 46485
externalPort = 5000

[objectStorage]
defaultBucketID = "replit-objstore-d0c6102a-e3a6-4b70-b8b9-ef6a6dc6f5ad"

[userenv]

[userenv.shared]
BACKUP_BUCKET_NAME = "replit-objstore-d0c6102a-e3a6-4b70-b8b9-ef6a6dc6f5ad"
