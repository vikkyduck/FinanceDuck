modules = ["nodejs-20", "web", "bun", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bun", "run", "build"]
publicDir = "dist"
run = ["bun", "run", "server/vite.ts"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run server/vite.ts"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 24678
externalPort = 3002

[[ports]]
localPort = 35563
externalPort = 3000

[[ports]]
localPort = 35731
externalPort = 5000

[[ports]]
localPort = 37297
externalPort = 3003

[[ports]]
localPort = 38727
externalPort = 3001

[[ports]]
localPort = 46453
externalPort = 4200
