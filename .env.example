# ─── FinanceDuck environment ──────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ коммитится в git (см. .gitignore).

# ─── Сервер ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Только loopback: снаружи приложение доступно через nginx. Другой адрес в production
# сервер не примет и не стартует.
HOST=127.0.0.1

# ─── База данных (Postgres) ────────────────────────────────────────────────
# Формат: postgres://user:password@host:port/dbname
# На Timeweb VDS Postgres слушает 127.0.0.1:5432.
DATABASE_URL=postgres://finance_duck:CHANGE_ME@127.0.0.1:5432/finance_duck

# ─── Бэкапы БД ─────────────────────────────────────────────────────────────
# Папка, куда сохраняются JSON-бэкапы (ежедневно в 3:00).
# Хранится 30 последних авто-бэкапов, ручные — пока не удалены вручную.
BACKUP_DIR=/var/finance-duck/backups

# Секрет для шифрования кодов доступа и бэкапов (минимум 32 символа).
# Сгенерируйте отдельно, например: openssl rand -hex 32
# Сохраните в защищённом хранилище: старые копии требуют исходного ключа.
ACCESS_CODE_SECRET=

# Дополнительные разрешённые origins через запятую; текущий origin разрешён.
# CORS_ORIGINS=https://your-cabinet.example

# Неизменяемые документы вне БД; постоянный каталог, не web root.
DOCUMENT_OBJECT_DIR=/var/finance-duck/objects
